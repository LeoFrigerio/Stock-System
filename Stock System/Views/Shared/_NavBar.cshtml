<nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                    <i class="bi bi-list"></i>
                </a>
            </li>
        </ul>
        <ul class="navbar-nav ms-auto align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle small text-secondary d-flex align-items-center" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>
                        <span>@User.Identity.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-controller="Cuenta" asp-action="CambiarPassword">
                                <i class="bi bi-key me-2"></i> Cambiar contraseña
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <span class="small text-secondary">
                        <i class="bi bi-person-circle me-1"></i>Bienvenido
                    </span>
                </li>
            }
        </ul>
    </div>
</nav>